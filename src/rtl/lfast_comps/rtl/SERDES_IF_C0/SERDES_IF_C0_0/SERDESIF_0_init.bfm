#------------------------------------------------------------
# SERDESIF_0  Initialization procedure
#------------------------------------------------------------


procedure SERDESIF_0_init;
write w SERDESIF_0 0x2028 0x10F; // SYSTEM_CONFIG_PHY_MODE_1
write w SERDESIF_0 0x1198 0x30; // LANE0_PHY_RESET_OVERRIDE
write w SERDESIF_0 0x1000 0x80; // LANE0_CR0
write w SERDESIF_0 0x1004 0x20; // LANE0_ERRCNT_DEC
write w SERDESIF_0 0x1008 0xF8; // LANE0_RXIDLE_MAX_ERRCNT_THR
write w SERDESIF_0 0x100c 0x80; // LANE0_IMPED_RATIO
write w SERDESIF_0 0x1014 0x29; // LANE0_PLL_M_N
write w SERDESIF_0 0x1018 0x20; // LANE0_CNT250NS_MAX
write w SERDESIF_0 0x101c 0x51; // LANE0_RE_AMP_RATIO
write w SERDESIF_0 0x1020 0x2F; // LANE0_RE_CUT_RATIO
write w SERDESIF_0 0x1024 0x80; // LANE0_TX_AMP_RATIO
write w SERDESIF_0 0x1028 0x15; // LANE0_TX_PST_RATIO
write w SERDESIF_0 0x1030 0x10; // LANE0_ENDCALIB_MAX
write w SERDESIF_0 0x1034 0x38; // LANE0_CALIB_STABILITY_COUNT
write w SERDESIF_0 0x103c 0x70; // LANE0_RX_OFFSET_COUNT
write w SERDESIF_0 0x11d4 0x2; // LANE0_GEN1_TX_PLL_CCP
write w SERDESIF_0 0x11d8 0x22; // LANE0_GEN1_RX_PLL_CCP
write w SERDESIF_0 0x1198 0x0; // LANE0_PHY_RESET_OVERRIDE
write w SERDESIF_0 0x1200 0x1; // LANE0_UPDATE_SETTINGS
write w SERDESIF_0 0x2028 0xF0F; // SYSTEM_CONFIG_PHY_MODE_1
return

#ifndef USE_SERDESIF
#define USE_SERDESIF
#endif

